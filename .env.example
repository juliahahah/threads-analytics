# ---------------------------------------------------------------------------
# Supabase —— 從 Supabase Dashboard > Project Settings > API 取得
# ---------------------------------------------------------------------------
# 專案 URL，例如 https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key：可安全暴露於瀏覽器，所有存取受 RLS 保護
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key：**僅限伺服器端**，可繞過 RLS。
# 僅在以 seed script 匯入貼文資料時需要；請勿加上 NEXT_PUBLIC_ 前綴。
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# 應用設定
# ---------------------------------------------------------------------------
# Magic Link 登入後的導回網址（本機開發用 http://localhost:3000）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 資料來源模式：
#   mock     = 直接讀取 data/posts.json（無須 Supabase，用於本機驗證）
#   supabase = 從 Supabase 讀取已匯入的貼文
DATA_SOURCE=mock

# 分析目標帳號
DEFAULT_ACCOUNT=emoless_com
